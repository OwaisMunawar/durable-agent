# Postgres used by the crash demo, the MCP server and the Postgres test suite.
# docker compose up -d starts one on this port.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/durable_agent

# Optional: run the example against a real model through the AI SDK gateway.
# Leave empty to use the built-in demo model (no network, no key).
AI_GATEWAY_API_KEY=
MODEL=openai/gpt-5-mini
